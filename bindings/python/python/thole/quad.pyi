from collections.abc import Callable
from typing import final

class ConvergenceError(RuntimeError): ...

@final
class Integral:
    @property
    def value(self) -> float: ...
    @property
    def error(self) -> float: ...
    @property
    def subintervals(self) -> int: ...
    @property
    def evaluations(self) -> int: ...

@final
class GaussLegendre:
    def __init__(self, n: int) -> None: ...
    @property
    def order(self) -> int: ...
    @property
    def nodes(self) -> list[float]: ...
    @property
    def weights(self) -> list[float]: ...
    def integrate(self, f: Callable[[float], float], a: float, b: float) -> float: ...

def gauss_legendre(f: Callable[[float], float], a: float, b: float, n: int) -> float: ...

def gauss_kronrod(
    f: Callable[[float], float],
    a: float,
    b: float,
    *,
    atol: float | None = None,
    rtol: float | None = None,
    max_subintervals: int | None = None,
) -> Integral: ...
